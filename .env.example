# Wzór NAZW zmiennych, których szuka kod w backend/src. Skopiuj do `backend/.env` i uzupełnij
# własnymi wartościami. To nie jest miejsce na prawdziwe sekrety z działającego środowiska.

# --- baza i serwer ---
# PostgreSQL; bez tego nie startuje nic (prisma/schema.prisma:10).
DATABASE_URL=postgresql://user:password@localhost:5432/belfero?schema=public
# Domyślnie 3000 (src/server.ts:17).
PORT=3000
# development | production. Przy production bramka Turnstile staje się obowiązkowa.
NODE_ENV=development
# Adres przeglądarki: dozwolony origin CORS i baza linków w mailach (server.ts:21, authController.ts:59).
FRONTEND_URL=http://localhost:5173

# --- uwierzytelnianie i maile ---
# Podpis tokenu JWT. Jeśli zostawisz puste, src/utils/jwt.ts:3 użyje zapasika wpisanego w źródle —
# na produkcji to oznacza tokeny podpisane sekretem znanym z publicznie dostępnego wzoru.
JWT_SECRET=
# Klucz wysyłki maili z linkiem potwierdzenia adresu i resetu hasła.
RESEND_API_KEY=

# Cloudflare Turnstile — bramka na boty przy rejestracji, logowaniu i prośbie o link do resetu hasła.
# Sitekey jest jawny (trafia do przeglądarki przez GET /api/auth/captcha-config),
# secret key nigdy nie opuszcza serwera.
# Bez obu kluczy te trzy endpointy w dev przechodzą bez weryfikacji; w produkcji (NODE_ENV=production)
# rzucają 503 zamiast cicho przepuścić boty — czyli bez kluczy NIKT się nie zaloguje.
# Do lokalnych testów Cloudflare udostępnia klucze zawsze przepuszczające:
# sitekey 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Bramka SMS do weryfikacji numeru telefonu.
# Pozostałe zmienne (DATABASE_URL, JWT_SECRET, RESEND_API_KEY, klucze AI) definiuj w backend/.env.

# log | smsapi | serwersms | hostedsms — przy braku ustawienia działa placeholder konsolowy,
# więc lokalne konto wstaje bez żadnych kluczy.
SMS_PROVIDER=log

# Nadawca widoczny w SMS-ie (alfanumeryczny).
SMS_SENDER_NAME=Belfero

# SMSAPI: token panelowy (https://www.smsapi.pl/panel/aplikacje)
SMSAPI_TOKEN=

# SerwerSMS: klucz API i login partnerski
SERWERSMS_API_KEY=
SERWERSMS_USERNAME=

# HostedSMS.pl (DCS): login i hasło do panelu, przekazywane w ciele zapytania SimpleApi.
# Sender to nadawca przydzielony przez operatora — SMS_SENDER_NAME musi mu odpowiadać.
SMS_HOSTEDSMS_EMAIL=
SMS_HOSTEDSMS_PASSWORD=

# --- ocena prac przez AI ---
# Realny koszt: każde POST /api/grading/sessions/:id/process wydaje saldo nauczyciela i płaci
# za tokeny Anthropic (src/services/aiGradingService.ts:605).
ANTHROPIC_API_KEY=
# Pozostałość po pierwszym dostawcy AI; konfiguracja jest czytana w src/config/openai.ts:5,
# ale żadna obecna ścieżka oceniania z niej nie korzysta.
OPENAI_API_KEY=

# --- płatności ---
# Tylko literal true pokazuje katalog doładowań w interfejsie (src/controllers/walletController.ts:37).
PAYMENTS_ENABLED=false
